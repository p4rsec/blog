---
import Layout from "../../layouts/Layout.astro";
import { BlogPost } from "../../components/BlogPost";
import { Navigation } from "../../components/Navigation";

const post = {
  title: "Hello World",
  date: "2025-10-18",
  slug: "hello-world",
  content: `Hello World!`,
