---
import Layout from "../layouts/Layout.astro";
import { Header } from "../components/Header";
import { BlogList } from "../components/BlogList";
import { Navigation } from "../components/Navigation";
import { getCollection } from "astro:content";

// Get all blog posts dynamically and sort by date (reverse chronological)
const allPosts = await getCollection("blog");
const posts = allPosts
  .map((post) => ({
    title: post.data.title,
    date: post.data.pubDate,
    slug: post.id,
    excerpt: post.data.description || "No description available.",
  }))
  .sort((a, b) => b.date.getTime() - a.date.getTime());
---

<Layout title="p4rsec's Blog">
  <Navigation currentPath="/" client:load />
  <Header
    title="p4rsec"
    subtitle="I am Prakash, software engineer from Bangalore, India"
  />
  <BlogList posts={posts} />
</Layout>
